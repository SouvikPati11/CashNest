# ---------------------------------------------------------------------------
# CashNest Backend — Environment Configuration (example)
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Application
APP_NAME=CashNest
APP_ENV=production            # local | staging | production
APP_DEBUG=false              # true only in local/staging
APP_URL=https://api.cashnest.app
APP_TIMEZONE=UTC
APP_KEY=                     # base64/random 32+ byte secret (generate before deploy)

# API
API_VERSION=v1
API_RATE_LIMIT=120           # default requests per window (per user/ip)
API_RATE_WINDOW=60           # window length in seconds

# Database (MySQL / InnoDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cashnest
DB_USERNAME=cashnest
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# JWT
JWT_SECRET=                  # strong random secret for HS256 signing
JWT_ALGO=HS256
JWT_ACCESS_TTL=1800          # access token lifetime (seconds) = 30 min
JWT_REFRESH_TTL=2592000      # refresh token lifetime (seconds) = 30 days
JWT_ISSUER=cashnest
JWT_AUDIENCE=cashnest-app
# Require a verified email before email/password login. Keep false unless a
# mailer (MAIL_DRIVER=smtp) is configured, otherwise users cannot log in.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Storage / paths (relative to backend root unless absolute)
STORAGE_PATH=storage
LOG_PATH=storage/logs
CACHE_PATH=storage/cache
UPLOAD_PATH=storage/uploads
QUEUE_PATH=storage/queue

# Logging
LOG_LEVEL=info               # debug | info | notice | warning | error | critical
LOG_CHANNEL=file

# Cache / Queue drivers (shared-hosting default = file)
CACHE_DRIVER=file
QUEUE_DRIVER=file

# CORS
CORS_ALLOWED_ORIGINS=*       # comma-separated list of allowed origins
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-App-Version,X-Platform,X-Device-Id,X-Idempotency-Key,X-Request-Id
CORS_MAX_AGE=86400

# File uploads
UPLOAD_MAX_SIZE=5242880      # bytes (5 MB)
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# Mail (interface only for now; driver wired later)
MAIL_DRIVER=log              # log | smtp
MAIL_FROM_ADDRESS=no-reply@cashnest.app
MAIL_FROM_NAME=CashNest

# Firebase Cloud Messaging (interface only for now)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=   # absolute path to service-account json, OUTSIDE web root
