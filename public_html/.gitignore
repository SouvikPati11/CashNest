# Dependencies
# NOTE: vendor/ is intentionally committed so the app runs on shared hosting
# (Hostinger) with no Composer/terminal step after upload. It contains only the
# production runtime dependency (firebase/php-jwt) plus Composer's optimized
# autoloader. Regenerate with: composer install --no-dev --optimize-autoloader

# Environment
.env
.env.*
!.env.example

# Storage (keep structure, ignore contents)
storage/logs/*
storage/cache/*
storage/uploads/*
storage/queue/*
!storage/**/.gitkeep

# PHPUnit
.phpunit.result.cache
.phpunit.cache/
/coverage/

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
