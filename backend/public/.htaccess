# ---------------------------------------------------------------------------
# CashNest API — public/.htaccess  (LiteSpeed / Apache safe, minimal)
#
# IMPORTANT: every directive here is wrapped in <IfModule>. Unguarded
# directives such as `Options`, `DirectoryIndex`, or `Require` require a
# matching AllowOverride class; on hosts where that class is not granted they
# make the web server reject the ENTIRE .htaccess with HTTP 500 — for every
# request, even a plain `<?php echo "Hello";`. Keeping everything inside
# <IfModule> guards avoids that failure mode.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve the Authorization header for Bearer tokens (LSAPI/CGI can strip it).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Front controller: route anything that is not a real file/dir to index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Security headers are safe: if mod_headers is absent the block is skipped.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer"
</IfModule>
