# ---------------------------------------------------------------------------
# CashNest API — project-root .htaccess  (LiteSpeed / Apache safe, minimal)
#
# Every directive is wrapped in <IfModule> so an unavailable AllowOverride
# class can never make the server reject the file with HTTP 500.
#
# Layout behaviour:
#   * docroot = public/            -> this file is never read.
#   * docroot = project root       -> forwards traffic into public/.
#   * app in a subdirectory of the docroot (e.g. public_html/backend/, reached
#     at /backend/public/...)      -> the !/public/ guard stops the rewrite
#     from double-prepending "public/", so there is no rewrite loop.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct access to framework internals (top-level segments only, so it
    # never clashes with API routes such as /public/v1/app/version).
    RewriteRule ^(\.env|\.env\..*|composer\.(json|lock)|core|app|config|routes|storage|database|tests|vendor)(/|$) - [F,L]

    # Forward into public/ unless the path is already inside public/ or is a
    # real file/directory here.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
