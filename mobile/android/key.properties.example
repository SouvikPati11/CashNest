# Android release signing — COPY to android/key.properties (git-ignored) and fill.
#
#   1. Generate an upload keystore:
#      keytool -genkey -v -keystore ~/cashnest-upload.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#   2. Set the values below and keep this file OUT of version control.
#
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/cashnest-upload.jks
